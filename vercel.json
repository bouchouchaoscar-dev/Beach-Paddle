{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cleanup-pending",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/reservations-beach-paddle-paris-marne-region-parisienne",
      "destination": "/#reservations",
      "permanent": true
    },
    {
      "source": "/reservations-beach-paddle-paris-marne-region-parisienne/",
      "destination": "/#reservations",
      "permanent": true
    },
    {
      "source": "/videos-stand-up-paddle-marne-paris",
      "destination": "/#videos",
      "permanent": true
    },
    {
      "source": "/videos-stand-up-paddle-marne-paris/",
      "destination": "/#videos",
      "permanent": true
    },
    {
      "source": "/la-presse-parle-de-beach-paddle",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/la-presse-parle-de-beach-paddle/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",       "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://img.youtube.com https://maps.gstatic.com https://maps.googleapis.com https://www.google.com https://maps.google.com; frame-src https://www.google.com https://maps.google.com https://www.youtube-nocookie.com; connect-src 'self' https://api.web3forms.com https://maps.googleapis.com https://icvjwdtdbbyzkuczxvzp.supabase.co wss://icvjwdtdbbyzkuczxvzp.supabase.co"
        }
      ]
    },
    {
      "source": "/Image Beach Paddle/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
